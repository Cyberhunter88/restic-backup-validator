# Copy to .env outside Git. Generate APP_MASTER_KEY with: openssl rand -base64 32
APP_MASTER_KEY=REPLACE_WITH_OPENSSL_GENERATED_BASE64_KEY
APP_URL=https://validator.example.invalid
OIDC_ISSUER=https://sso.example.invalid/application/o/backup-validator/
OIDC_CLIENT_ID=REPLACE_WITH_OIDC_CLIENT_ID
OIDC_CLIENT_SECRET=REPLACE_WITH_OIDC_CLIENT_SECRET
OIDC_GROUP_CLAIM=groups
